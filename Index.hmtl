<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <title>Celestial Legion Studio — Angelic Trading Hub</title>
        
          <!-- ======================================================== -->
            <!--        ELITE WEB3 ANTI-HIJACK SECURITY SUITE             -->
              <!-- ======================================================== -->
                <meta http-equiv="X-Frame-Options" content="DENY">
                  <meta http-equiv="Content-Security-Policy" content="
                      default-src 'self'; 
                          script-src 'self' 'unsafe-inline' https://jsdelivr.net https://unpkg.com; 
                              connect-src 'self' https://xrplcluster.com https://xumm.app wss://*.xrplcluster.com https://coingecko.com; 
                                  img-src 'self' data: https:; 
                                      style-src 'self' 'unsafe-inline' https://googleapis.com https://jsdelivr.net;
                                          font-src 'self' https://gstatic.com;
                                              frame-ancestors 'none';
                                                ">
