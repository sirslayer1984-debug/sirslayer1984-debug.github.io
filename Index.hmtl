<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Celestial Angels - XRPL Hub</title>
    <style>
        :root {
            --bg-cosmic: #0a0b10;
            --angel-gold: #f39c12;
            --angel-glow: #f1c40f;
            --text-light: #f5f6fa;
            --glass-panel: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(241, 196, 15, 0.15);
        }

        body {
            margin: 0;
            font-family: 'Segoe UI', Arial, sans-serif;
            background: radial-gradient(circle at center, #111424 0%, var(--bg-cosmic) 100%);
            color: var(--text-light);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        header {
            text-align: center;
            padding: 60px 20px 20px 20px;
        }

        header h1 {
            font-size: 3rem;
            margin: 0;
            text-transform: uppercase;
            letter-spacing: 4px;
            background: linear-gradient(135deg, #ffffff 30%, var(--angel-glow) 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0 0 30px rgba(241, 196, 15, 0.2);
        }

        header p {
            color: #8a8f9d;
            font-size: 1.1rem;
            margin-top: 10px;
        }

        .container {
            width: 100%;
            max-width: 1200px;
            padding: 20px;
            box-sizing: border-box;
        }

        .gallery-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 30px;
            margin-bottom: 60px;
        }

        .nft-card {
            background: var(--glass-panel);
            border: 1px solid var(--glass-border);
            border-radius: 16px;
            padding: 20px;
            text-align: center;
            backdrop-filter: blur(10px);
            transition: all 0.3s ease;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        .nft-card:hover {
            transform: translateY(-5px);
            border-color: var(--angel-gold);
            box-shadow: 0 15px 40px rgba(241, 196, 15, 0.15);
        }

        .nft-image-holder {
            width: 100%;
            height: 380px;
            border-radius: 12px;
            margin-bottom: 15px;
            border: 1px solid rgba(255,255,255,0.05);
            object-fit: cover;
        }

        .action-panel {
            background: var(--glass-panel);
            border: 1px solid var(--glass-border);
            border-radius: 20px;
            padding: 40px;
            text-align: center;
            backdrop-filter: blur(10px);
            max-width: 600px;
            margin: 0 auto 60px auto;
            box-shadow: 0 20px 50px rgba(0,0,0,0.6);
        }

        .btn-premium {
            background: linear-gradient(135deg, var(--angel-gold) 0%, #d4ac0d 100%);
            color: #000;
            border: none;
            padding: 16px 40px;
            font-size: 1.1rem;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 5px 20px rgba(241, 196, 15, 0.4);
            transition: all 0.3s ease;
        }

        .btn-premium:hover {
            transform: scale(1.03);
            box-shadow: 0 8px 30px rgba(241, 196, 15, 0.6);
        }

        .status-box {
            margin-top: 20px;
            font-family: monospace;
            color: #00ffcc;
            font-size: 0.9rem;
            white-space: pre-wrap;
            text-align: left;
            padding: 10px;
            background: rgba(0,0,0,0.3);
            border-radius: 8px;
        }

        footer {
            margin-top: auto;
            padding: 40px;
            font-size: 0.85rem;
            color: #5a5f73;
            text-align: center;
        }
    </style>
    <script src="https://unpkg.com"></script>
</head>
<body>

    <header>
        <h1>Celestial Angels</h1>
        <p>Secure Peer-to-Peer NFT Trading & Verification Hub on the XRP Ledger</p>
    </header>

    <div class="container">
        <div class="gallery-grid" id="angel-gallery">
            <!-- Cards will be dynamically added here by the script below -->
        </div>

        <div class="action-panel">
            <button class="btn-premium" id="wallet-btn" onclick="toggleWalletConnection()">Connect XRPL Wallet</button>
            <div class="status-box" id="status-log">> System Status: Offline. Awaiting wallet authentication...</div>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 Celestial Angels. All Rights Reserved.</p>
    </footer>

    <script>
        let client;
        let isConnected = false;
        const statusLog = document.getElementById('status-log');
        const walletBtn = document.getElementById('wallet-btn');

        // I wrote your exact 20 image filenames right here into your website layout data!
        const angelImages = [
            "image_suu9gK.png", "image_FoTN4c.png", "image_AHSS5y.png", "image_FEz7Wz.png",
            "image_puhF7x.png", "image_wpoV-M.png", "image_T0Tpiw.png", "image_V0lgMQ.png",
            "image_mmqyl8.png", "image_TkF1gD.png", "image_GUpt7i.png", "image_s1LQNA.png",
            "image_jcxq9S.png", "image_pPNlx6.png", "image_s7R0rU.png", "image_L004r6.png",
            "image_ugH4eh.png", "image_rjRY0K.png", "image_1SnNPl.png", "image_p_zm59.png"
        ];

        const gallery = document.getElementById('angel-gallery');
        
        // Dynamically build the 20 metadata cards on your screen
        angelImages.forEach((filename, index) => {
            gallery.innerHTML += `
                <div class="nft-card">
                    <img src="${filename}" class="nft-image-holder" alt="Angel Sovereign #${index + 1}" onerror="this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://w3.org\' width=\'100%\' height=\'100%\' viewBox=\'0 0 100 100\'><rect width=\'100%\' height=\'100%\' fill=\'%23161a36\'/><text x=\'50%\' y=\'55%\' dominant-baseline=\'middle\' text-anchor=\'middle\' font-size=\'30\'>👼</text></svg>'">
                    <h3>Angel Sovereign #${index + 1}</h3>
                    <p>Status: Authenticated on XRPL</p>
                    <button class="btn-premium" style="padding: 8px 20px; font-size: 0.85rem;" onclick="viewOffer(${index + 1})">View Offer</button>
                </div>
            `;
        });

        function logMessage(msg) {
            statusLog.innerText = `> ${msg}`;
        }

        async function toggleWalletConnection() {
            if (isConnected) {
                logMessage("Disconnecting from XRP Ledger node...");
                if (client) await client.disconnect();
                isConnected = false;
                walletBtn.innerText = "Connect XRPL Wallet";
                logMessage("System Status: Offline. Wallet disconnected.");
                return;
            }

            try {
                logMessage("Connecting to secure public XRPL Mainnet Cluster (wss://xrplcluster.com)...");
                walletBtn.innerText = "Connecting...";
                
                client = new xrpl.Client("wss://xrplcluster.com");
                await client.connect();
                
                isConnected = true;
                walletBtn.innerText = "Disconnect Wallet";
                logMessage("System Status: Connected to XRPL Mainnet! Ready to read digital token records.");
                
            } catch (error) {
                console.error(error);
                walletBtn.innerText = "Connect XRPL Wallet";
                logMessage(`Connection Error: Unable to sync with blockchain node. ${error.message}`);
            }
        }

        function viewOffer(slotId) {
            if (!isConnected) {
                alert("Please authenticate your Web3 XRPL Wallet before checking live marketplace asset offers!");
                return;
            }
            logMessage(`Querying open transaction orders on the ledger for Angel Slot #${slotId}...`);
        }
    </script>
</body>
</html>

